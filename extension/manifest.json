{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "AdBye",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "es",
  "homepage_url": "https://github.com/oskarko/Adbye",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AdBye",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "contextMenus",
    "webRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/cosmetic.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content/youtube.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-48.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "easylist",
        "enabled": true,
        "path": "rulesets/easylist.json"
      },
      {
        "id": "easylist-es",
        "enabled": false,
        "path": "rulesets/easylist-es.json"
      },
      {
        "id": "easylist-de",
        "enabled": false,
        "path": "rulesets/easylist-de.json"
      },
      {
        "id": "liste-fr",
        "enabled": false,
        "path": "rulesets/liste-fr.json"
      },
      {
        "id": "easylist-it",
        "enabled": false,
        "path": "rulesets/easylist-it.json"
      },
      {
        "id": "easylist-pt",
        "enabled": false,
        "path": "rulesets/easylist-pt.json"
      },
      {
        "id": "easylist-nl",
        "enabled": false,
        "path": "rulesets/easylist-nl.json"
      },
      {
        "id": "easyprivacy",
        "enabled": true,
        "path": "rulesets/easyprivacy.json"
      },
      {
        "id": "anti-cv",
        "enabled": true,
        "path": "rulesets/anti-cv.json"
      },
      {
        "id": "cookies",
        "enabled": true,
        "path": "rulesets/cookies.json"
      },
      {
        "id": "annoyances",
        "enabled": true,
        "path": "rulesets/annoyances.json"
      },
      {
        "id": "notifications",
        "enabled": true,
        "path": "rulesets/notifications.json"
      },
      {
        "id": "social",
        "enabled": false,
        "path": "rulesets/social.json"
      },
      {
        "id": "nocoin",
        "enabled": true,
        "path": "rulesets/nocoin.json"
      }
    ]
  }
}
